{
  "name": "gungi-oracle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "board-to-test": "node prototype/board-to-test.mjs",
    "check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{js,json,ts}\"",
    "dev-client": "cd .. && npx tsx client/server.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{js,json,ts}\"",
    "gsfen": "npx tsx script/gsfen.ts",
    "gsfen:gen": "npx tsx script/gsfen-gen.ts",
    "lint": "eslint src tests",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.1.1",
    "eslint": "^9.0.0",
    "fast-check": "^4.9.0",
    "prettier": "^3.0.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
